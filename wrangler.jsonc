{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	// a version uploaded without deploying gets its own preview URL (private testing before going live)
	"preview_urls": true,
	"vars": {
		// Lead notifications (the Resend key is a secret: npx wrangler secret put RESEND_API_KEY)
		"LEAD_EMAIL_TO": "fodi85999@gmail.com"
	},
	// Workers Paid (since 2026-11-22): CPU time per request. A page takes 50–600 ms, the free plan's 10 ms cut them off.
	"limits": {
		"cpu_ms": 30000
	},
	// The public MCP server (/mcp): requests per client address per minute
	"ratelimits": [
		{
			"name": "MCP_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "blog"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "blog-opennext-cache"
		},
		{
			// Monge model files (STEP for Pro, app releases)
			"binding": "FILES",
			"bucket_name": "monge-files",
			"remote": true
		}
	],
	"d1_databases": [
		{
			// Monge library catalogue + leads
			"binding": "DB",
			"database_name": "monge",
			"database_id": "e73132d7-c97a-45af-a107-a79cbbb480e9",
			"migrations_dir": "migrations",
			"remote": true
		}
	]
}
